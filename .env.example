# SystemMapper Production Environment Variables
# Copy this file to .env and fill in the values before deploying

# GitHub personal access token (recommended to avoid rate limits during scanning)
GITHUB_TOKEN=

# API URL used by the frontend to talk to the backend
# If deploying to a remote server, change this to the server's IP or Domain name
# (e.g., http://203.0.113.1:3001 or https://api.my-system-mapper.com)
NEXT_PUBLIC_API_URL=http://localhost:3001
